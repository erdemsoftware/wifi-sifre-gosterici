<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5"
    android:padding="16dp">

    <!-- Üst Başlık ve Ağ Sayacı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📶 WiFi Şifreleri"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1565C0" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 Ağ"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:background="#E3F2FD"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Canlı Arama Çubuğu -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="🔍 Wi-Fi adı veya şifre ara..."
        android:background="@drawable/search_bg"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:textSize="14sp"
        android:textColor="#212121"
        android:textColorHint="#888888"
        android:singleLine="true"
        android:layout_marginBottom="12dp" />

    <!-- Hızlı Eylem Butonları -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Yenile"
            android:textSize="13sp"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF" />

        <Space
            android:layout_width="6dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnCopyAll"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.2"
            android:text="Hepsini Kopyala"
            android:textSize="13sp"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF" />

        <Space
            android:layout_width="6dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.2"
            android:text="Dışa Aktar"
            android:textSize="13sp"
            android:backgroundTint="#E65100"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Durum ve Hata Metni -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Root izni kontrol ediliyor..."
        android:textSize="12sp"
        android:textColor="#555555"
        android:layout_marginBottom="8dp" />

    <!-- Ağ Listesi -->
    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="10dp" />

    <!-- Alt Kısım: GitHub Alanı -->
    <LinearLayout
        android:id="@+id/layoutGithub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#E0E0E0"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ GitHub: erdemsoftware/wifi-sifre-gosterici ↗"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#212121" />
    </LinearLayout>
</LinearLayout>
